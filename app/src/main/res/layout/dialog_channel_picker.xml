<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/bg_panel"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/channel_picker_title"
        android:textAppearance="@style/TextAppearance.TruvendCam.Title" />

    <RadioGroup
        android:id="@+id/pickerStreamGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <RadioButton
            android:id="@+id/pickerRadioMain"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/stream_main"
            android:textColor="@color/text_primary" />

        <RadioButton
            android:id="@+id/pickerRadioSub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:minHeight="48dp"
            android:text="@string/stream_sub"
            android:textColor="@color/text_primary" />
    </RadioGroup>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/pickerList"
        android:layout_width="match_parent"
        android:layout_height="320dp"
        android:layout_marginTop="8dp" />
</LinearLayout>
